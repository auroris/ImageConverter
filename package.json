{
  "name": "imageconverter",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "lint": "eslint . && web-ext lint --source-dir src",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "audit:ci": "npm audit --audit-level=moderate",
    "start:firefox": "web-ext run --source-dir src",
    "start:chromium": "npm run build && web-ext run --source-dir dist/chromium --target chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.8.0",
    "web-ext": "^10.8.0"
  }
}
