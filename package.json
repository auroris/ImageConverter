{
  "name": "imageconverter",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . && web-ext lint --source-dir src",
    "build": "node scripts/build.mjs",
    "start:firefox": "web-ext run --source-dir src",
    "start:chromium": "npm run build && web-ext run --source-dir dist/chromium --target chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "web-ext": "^10.5.0"
  }
}
